# Build output (per-platform; rebuilt on the target machine)
cc-agent
future-code

# Dependencies (platform-specific natives; regenerated via bun install)
node_modules/

# Local tool artifacts
*.log
.DS_Store

# Secrets (do not commit)
deepseek.env

# Temp/debug files
dbg_tmp.test.ts

# Large binaries (regenerated from source)
*.zip

# Paper build artifacts
paper/main.aux
paper/main.out
hact-paper/*/paper/main.aux
hact-paper/*/paper/main.out
paper/main.bbl
paper/main.blg
paper/mtest.out

# future-code harness state (generated per-project, machine-local paths,
# run history, and self-improvement decisions — regenerate with
# `bun src/harness/cli.ts build`)
.future-code/
paper/main.aux
paper/main.out
paper/missfont.log
paper/main.log
__pycache__/

# Per-project playwright browser-session logs (regenerable)
.playwright-mcp/

# Harness plans (machine-local drafts; snapshots of final plans live in the
# outer home-dir repo)
.future/plans/

# RSI cycle measurement ledger (machine-local telemetry; see
# docs/agent-platform/RSI_LOOP.md — regenerate with scripts/rsi-cycle-snapshot.ts)
.future/rsi-cycle.jsonl
