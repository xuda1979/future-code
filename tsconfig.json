{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "color-diff-napi": ["./src/native-ts/color-diff/index.ts"],
      "modifiers-napi": ["./src/native-ts/modifiers/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
